{
  "hooks": {
    "SessionStart": [
      {
        "command": "python .agents/hooks/session_start.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/pre_tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/post_tool.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "command": "python .agents/hooks/on_stop.py"
      }
    ],
    "SubagentStop": [
      {
        "command": "python .agents/hooks/on_stop.py"
      }
    ]
  }
}
